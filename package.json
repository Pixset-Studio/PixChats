{
  "name": "pixchats",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npx tsc --noEmit --project apps/web/tsconfig.json",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dist:desktop": "npm run dist --workspace=apps/desktop",
    "build:mobile-web": "npm run build:web --workspace=apps/mobile && npm run copy:web --workspace=apps/mobile"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
